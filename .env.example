# Copie para .env.local (nunca versione o .env.local) e preencha.
# Em produção, cadastre cada uma em Vercel → Project → Settings → Environment Variables.

# URL pública do app (sem barra no final)
APP_URL=https://acesso.seonaia.com.br

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM="SEO na IA <acesso@seonaia.com.br>"

# Segredo para assinar o cookie de sessão (64+ caracteres aleatórios)
SESSION_SECRET=

# Token que vai na URL do webhook: /api/webhook/cakto?token=...
WEBHOOK_URL_TOKEN=

# "secret" que a Cakto gera ao criar o webhook (valida a assinatura X-Cakto-Signature)
CAKTO_WEBHOOK_SECRET=

# Segredo que a Vercel envia no cron diário (/api/saude). Qualquer texto aleatório longo.
CRON_SECRET=
